{
  "expo": {
    "name": "Motorly",
    "slug": "motorly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111821",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motorly.app"
    },
    "android": {
      "package": "com.motorly.app",
      "adaptiveIcon": {
        "backgroundColor": "#173F35"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Motorly",
      "shortName": "Motorly",
      "description": "Fuel, expense, vehicle, route, and convoy analytics.",
      "themeColor": "#111821",
      "backgroundColor": "#111821",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Motorly uses your photos to attach fuel receipts, service bills, and dashboard readings."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Motorly to use your microphone for walkie-talkie voice messages."
        }
      ]
    ]
  }
}
